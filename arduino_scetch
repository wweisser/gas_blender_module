}

bool valve_max_flow_test(Valve* v) {
  int max_flow = 0;
  bool closed = false;

  if (read_flow_sensor(v) <= 0) {
    open_n_steps(v, 50, 600);
    max_flow = read_flow_sensor(v);
    closed = close_valve(v);
  }
  delay(5000);
  if (max_flow < 1500 || !closed) {
      Serial.print("<gbm>m:error ");
      Serial.print(v->name);
      Serial.print(" gas flow insufficient: ");
      Serial.println(max_flow);
      return (false);
  }
  v->active = true;
  Serial.println("<gbm>n:Zeroing ");
  Serial.print(v->name);
  Serial.println(" check");
  return (true);
}

bool air_calibration_test(Valve* air_valve) {
  int attemt = 0;
  float fio2 = oxygen.readOxygenConcentration();
  
  if(oxygen.clearCalibration()) {
    open_n_steps(air_valve, 400, 100);

    while (attemt < 5){
      fio2 = oxygen.readOxygenConcentration();
      if (fio2 < 22 && oxygen.calibration_20_9()) {
        Serial.println("<gbm>m:Zeroing oxygen sensor at 21% check");
        close_valve(air_valve);
        return true;
      }
      delay(3000);
    }
    Serial.println("<gbm>e:Zeroing oxygen sensor at 21% failed");
    close_valve(air_valve);
    return false;
  }
}

bool oxygen_supply_test(Valve* v_ox) {
  int attemt = 0;
  float fio2 = oxygen.readOxygenConcentration();
  
  open_n_steps(v_ox, 400, 100);

  while (attemt < 5){
    fio2 = oxygen.readOxygenConcentration();
    if (fio2 > 80 ) {
      Serial.print("<gbm>m:Sufficient oxygen supply: ");
      Serial.print(fio2);
      Serial.println("% check");
      close_valve(v_ox);
      return true;
    }
    delay(3000);
  }
  Serial.print("<gbm>e:Insufficient Oxygen Supply: ");
  Serial.print(fio2);
  Serial.println("%");
  close_valve(v_ox);
  return false;
}

bool self_test(Check_list* cl, Valve v_ox, Valve v_air, Ox_sensor oxs) {
  cl->av_closed = zero_calibration_test(&v_air);
  cl->ov_closed = zero_calibration_test(&v_ox);

  if (cl->av_closed && cl->ov_closed) {
    Serial.println("<gbm>m:zero flow check");
    cl->av_max_flow = valve_max_flow_test(&v_air);
    if (cl->av_max_flow) {
      Serial.println("<gbm>m:max air flow check");
      cl->ox_21_call = air_calibration_test(&v_air);
      if (cl->ox_21_call) {
        Serial.println("<gbm>m:21% callibration check");
        cl->ov_max_flow = valve_max_flow_test(&v_ox);
        if (cl->ov_max_flow) {
          Serial.println("<gbm>m:max ox flow check");
          cl->ox_supply = oxygen_supply_test(&v_ox);
          if (cl->ox_supply) {
            Serial.println("<gbm>m:oxygen supply check");
            Serial.println("<gbm>m:sf_fail");
            return (true);
          }
        }
      }
      else
        Serial.println("<gbm>e:21% callibration failed");
    }
  }
  else
    Serial.println("<gbm>m:zero flow failed");
  Serial.println("<gbm>m:sf_fail");
  return (false);
}

//<gbm>m:mode|set_fio2|set_total_flow|set_oxygen_flow|set_air_flow>
//<gbm>m:mode|0000|0000|0000|0000>
//mode is one of: mnl -> manual ox and air flow adjustment || aut -> set fio2 and total_flow
int parse_serial_msg(String msg, Ox_sensor* oxs, Valve* v_ox, Valve* v_air) {
  if (msg.substring(0, 4) == "<sys>") {
    if (msg.substring(4, 5) == "m") {
      if (msg.substring(6, 9) == "aut") {
        oxs->set_fio2 = msg.substring(15, 19).toInt();
        oxs->total_flow = msg.substring(20, 24).toInt();
      }
      else if (msg.substring(6, 9) == "mnl") {
        v_ox->set_flow = msg.substring(25, 29).toInt();
        v_air->set_flow = msg.substring(30, 34).toInt();
      }
    }
    return 1;
  }
  else
    return 0;
}

//<sys>m:state|set_fio2|set_total_flow|set_oxygen_flow|set_air_flow|fio2|total_flow|oxygen_flow|air_flow>
//<sys>m:state|0000|0000|0000|0000|0000|0000|0000|0000>
int broadcast_state(Ox_sensor oxs, Valve v_ox, Valve v_air) {
  String set_fio2 = String(oxs.set_fio2);
  String set_total_flow = String(oxs.total_flow);
  String set_oxygen_flow = String(v_ox.set_flow);
  String set_air_flow = String(v_air.set_flow);
  String fio2 = String(oxs.curr_fio2);
  String oxygen_flow = String(v_ox.cur_flow);
  String air_flow = String(v_air.cur_flow);

  String bcst_str = "<gbm>m:state|" + set_fio2 + "|" + set_total_flow + "|" + set_oxygen_flow + "|" + set_air_flow + "|" + fio2 + "|" + oxygen_flow + "|" + air_flow;
  Serial.println(bcst_str);
  return 0;
}

