}

void loop() {
  String msg = Serial.readString();
  parse_serial_msg(msg, &oxs, &v_ox, &v_air);
  // Serial.println("MILESTONE 1 \n");
  read_flow_sensor(&v_ox);
  read_flow_sensor(&v_air);
  // Serial.println("MILESTONE 2 \n");

  oxs.curr_fio2 = oxygen.readOxygenConcentration();
  // Serial.println("MILESTONE 3 \n");

  calc_flows(oxs, &v_ox, &v_air);
  // Serial.println("MILESTONE 4 \n");

  controll_valve(v_ox);
  controll_valve(v_air);
  // Serial.println("MILESTONE 5 \n");

  oxs.curr_fio2 = oxygen.readOxygenConcentration();
  broadcast_state(oxs, v_ox, v_air);

  delay(3000);
}
