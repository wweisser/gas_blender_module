int atoi(char* str) {
  int i = 0;
  int result = 0;
  while (str[i] >= '0' && str[i] <= '9') {
    if(result > 999)
      break;
    result = result * 10 + (str[i] - '0');
    i++;
  }
  return (result);
}

int calc_flows(int set_fio2, int* set_flows, int set_ac_flow){
  float index_ox = 0.0;
  float index_air = 0.0;

  if(set_fio2 >= 21 && set_fio2 <= 100){
    index_ox = ((set_fio2-21)/0.79)/100;
    index_air = (1-(index_ox));
    set_flows[0] = index_ox * set_ac_flow;
    set_flows[1] = index_air * set_ac_flow;
  }
  return(set_flows);
}

