void step(bool dir, int* pin_arr, int speed){
  int gab = 1000/speed;
  if(!dir){
    for(int i=0; i<4;){
      digitalWrite(pin_arr[i], HIGH);
      delay(gab);
      i++;
      digitalWrite(pin_arr[i-1], LOW);
    }
  }
  else{
    for(int i=3; i>=0;){
      digitalWrite(pin_arr[i], HIGH);
      delay(gab);
      i--;
      digitalWrite(pin_arr[i+1], LOW);
    }
  }
}

// 2038 steps in total
int open_n_steps(int cur_open_state, int* pin_arr, int speed, int steps){
  if (cur_open_state < 1500){
    for(int i=0; i<steps; i++){
      step(true, pin_arr, speed);
      Serial.println("opening");
    }
    return(cur_open_state + steps);
  }
}

int close_n_steps(int cur_open_state, int* pin_arr, int speed, int steps){
  if (cur_open_state > 0){
    for(int i=0; i<steps; i++){
      step(false, pin_arr, speed);
      Serial.println("closing");

    }
    return(cur_open_state - steps);
  }
}

