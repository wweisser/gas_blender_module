int read_flow_sensor(Valve* v) {
  float flow = 0;
  float sensor_data_voltage = 0;
  long mean_flow = 0;

  int i = 0;
  for(i;i<300;i++){
    sensor_data_voltage = (analogRead(v->sensor_pin) / 1023.0) * 4.8;
    flow = (2000 * (powf(sensor_data_voltage, v->gain) - v->v_zero) / (v->v_max));
    mean_flow = mean_flow + flow;
  }
  mean_flow = mean_flow / 1000;
  v->cur_flow = mean_flow;
  return (mean_flow);
}

