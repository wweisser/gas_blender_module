bool close_valve(Valve* v) {
  int steps = 0;
  read_flow_sensor(v);

  while (v->cur_flow > 0) {
    read_flow_sensor(v);
    close_n_steps(v, 50, 3);
    steps++;
    if (v->cur_flow <= 0)
      return true;
    if (steps > 500 && v->cur_flow > 0)
      return false;
  }
}

bool zero_calibration_test(Valve* v) {
  int max_flow = 0;
  int steps = 0;
