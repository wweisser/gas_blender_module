void step(bool dir, int* pin_arr, int speed) {
  int gab = 1000 / speed;
  if (!dir) {
    for (int i = 0; i < 4;) {
      digitalWrite(pin_arr[i], HIGH);
      delay(gab);
      i++;
      digitalWrite(pin_arr[i - 1], LOW);
    }
  } else {
    for (int i = 3; i >= 0;) {
      digitalWrite(pin_arr[i], HIGH);
      delay(gab);
      i--;
      digitalWrite(pin_arr[i + 1], LOW);
    }
  }
}

// 2038 steps in total
int close_n_steps(Valve v, int speed, int n) {
  if (v.opening_state > 0 && n <= v.opening_state) {
    for (int i = 0; i < n; i++) {
      step(true, v.pin_arr, speed);
    }
    return (v.opening_state - n);
  }
  return(v.opening_state);
}

int open_n_steps(Valve v, int speed, int n) {
  if (v.opening_state < 500 && n <= 100) {
    for (int i = 0; i < n; i++) {
      step(false, v.pin_arr, speed);
      // Serial.println("closing");
    }
    return (v.opening_state + n);
  }
  return(v.opening_state);
}

int read_flow_sensor(Valve v) {
  float flow = 0;
  int i = 0;
  float sensor_data_voltage = 0;
  for (i = 0; i < 500; i++) {
    sensor_data_voltage = (analogRead(v.sensor_pin) / 1023.0) * 5.0;
    flow = flow + (2000 * (sensor_data_voltage - v.v_zero) / (v.v_max - 1.0));
  }
  flow = flow / 500;
  // Serial.print(sensor_data_voltage - v.v_zero);
  return (flow);
}

int serial_print_flow(Valve v, bool ser_output) {
  int cur_flow = read_flow_sensor(v);
  if (ser_output) {
    Serial.print("flow : ");
    Serial.print(v.cur_flow);
    Serial.println(" ml/min");
  }
  return (cur_flow);
}

bool v_zero_calibration(Valve v) {
  Serial.print("opening_state of ");
  Serial.print(v.name);
  Serial.print(" : ");
  Serial.println(v.opening_state);
  int flow = 1;
  int steps = 0;
  v.cur_flow = serial_print_flow(v, true);
  open_n_steps(v, 100, 50);
  while (v.cur_flow > 0) {
    v.cur_flow = serial_print_flow(v, true);
    close_n_steps(v, 500, 3);
    if (flow == 0) {
      close_n_steps(v, 10, 3);
      steps++;
    delay(2000);
    if (steps > 1000) {
      Serial.println(": Valve Zeroing failed");
      return (false);
      }
    }
  }
  Serial.println(": Valve Zeroing conpleted");
  return (true);
}

int controll_valve(Valve v){
  int delta = 0;
  float delta_rel = 0.0;
  int steps = 0;
  if(v.set_flow > 0)
    delta = v.set_flow-v.cur_flow;
  // Serial.print("Delta: ");
  // Serial.println(delta);
  delta_rel = (delta/2000.0f);
  // Serial.print("Delta_rel: ");
  // Serial.println(delta_rel);
  if(delta_rel < 0)
    delta_rel = delta_rel * (-1);
  // Serial.print("Delta_rel unsigned: ");
  // Serial.println(delta_rel);
  steps = delta_rel * 512;
  // Serial.print("Calculated Steps: ");
  // Serial.println(steps);
  if(steps > 100)
    steps = 100;
  if(delta > 4)
    v.opening_state = open_n_steps(v, 100, steps);
  if(delta < -4){
    v.opening_state = close_n_steps(v, 100, steps);
  }
  return(v.opening_state);
}

