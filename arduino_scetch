void ox_zero_calibration(Valve ox_valve, Valve air_valve) {
  float oxygen_data = 0.0;
  
  ox_valve.cur_flow = read_flow_sensor(ox_valve);
  if(oxygen.clearCalibration()) {
    Serial.println("clear calibration success!\n");
    air_valve.opening_state = open_n_steps(air_valve, 400, 100);
    show_ox();

    oxygen_data = oxygen.readOxygenConcentration();
    while (!(oxygen_data < 23)){
      oxygen_data = oxygen.readOxygenConcentration();
      Serial.println(oxygen_data);
      delay(1000);
    }
    delay(10000);
    if(oxygen.calibration_20_9()) 
        Serial.println("20.9 calibration success!");
    else
      Serial.println("20.9 calibration failed!");
  v_air.opening_state = 500;
  v_air.active = v_zero_calibration(v_air);

    ox_valve.opening_state = open_n_steps(ox_valve, 400, 100);
    show_ox(); 
    while (!(oxygen_data > 95)){
      oxygen_data = oxygen.readOxygenConcentration();
      Serial.print("Waiting for oxygen flow: ");
      show_ox();
      delay(1000);
    }
    delay(10000);
    if(oxygen.calibration_99_5()) 
      Serial.println("99.5 calibration success!");
    else
      Serial.println("99.5 calibration failed!");
  }
  v_ox.opening_state = 500;
  v_ox.active = v_zero_calibration(v_ox);
}

