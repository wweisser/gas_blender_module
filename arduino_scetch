void calc_flows(Ox_sensor oxs, Valve* v_ox, Valve* v_air) {
  int set_fio2 = oxs.set_fio2;
  int total_flow = oxs.total_flow;
  float ox_frac = 0.0;
  float air_frac = 0.0;

  if(set_fio2 >= 21 && set_fio2 <= 100){
    ox_frac = ((set_fio2-21)/0.79)/100;
    air_frac = (1-(ox_frac));
    v_ox->set_flow = ox_frac * total_flow;
    v_air->set_flow = air_frac * total_flow;
  }
  return;
}

void step(bool dir, int* pin_arr, int speed) {
  int gab = 1000 / speed;
  if (!dir) {
    for (int i = 0; i < 4;) {
      digitalWrite(pin_arr[i], HIGH);
      delay(gab);
      i++;
      digitalWrite(pin_arr[i - 1], LOW);
    }
  } else {
    for (int i = 3; i >= 0;) {
      digitalWrite(pin_arr[i], HIGH);
      delay(gab);
      i--;
      digitalWrite(pin_arr[i + 1], LOW);
    }
  }
}

int close_n_steps(Valve* v, int speed, int n) {
  int os = v->opening_state;
  if (v->opening_state > 0 && n <= v->opening_state) {
    for (int i = 0; i < n; i++)
      step(true, v->pin_arr, speed);
    v->opening_state = os-n;
  }
  return(v->opening_state);
}

int open_n_steps(Valve* v, int speed, int n) {
  int os = v->opening_state;
  if (v->opening_state < 500 && n <= 100) {
    for (int i = 0; i < n; i++) 
      step(false, v->pin_arr, speed);
    v->opening_state = os + n;
  }
  return(v->opening_state);
}

int controll_valve(Valve v) {
  int delta = 0;
  float delta_rel = 0.0;
  int steps = 0;

  if(v.set_flow >= 0)
    delta = v.set_flow-v.cur_flow;
  steps = powf(delta, 1.0/3.0);
  // Serial.print("Calculated Steps: ");
  // Serial.println(steps);
  if(delta < 0)
    steps = delta * (-1);
  // Serial.print("steps unsighend: ");
  // Serial.println(steps);
  // Serial.print("Steps: ");
  // Serial.println(steps);
  if(steps > 10)
    steps = 4;
  if(delta > 4)
    v.opening_state = open_n_steps(&v, 100, steps);
  if(delta < -4){
    v.opening_state = close_n_steps(&v, 100, steps);
  }
  return(v.opening_state);
}

